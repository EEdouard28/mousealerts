# MouseAlerts Admin Configuration
# Copy this file to .env.local and update with your values

# Admin Access Control
ADMIN_EMAILS=admin@mousealerts.com,your-email@domain.com
ADMIN_USER_IDS=admin-user-123,your-user-id-456

# Admin Security
ADMIN_SECRET_KEY=your-super-secret-admin-key-change-this-in-production
ADMIN_IP_WHITELIST=192.168.1.100,10.0.0.50  # Optional: restrict admin access to specific IPs

# Admin Session Settings
ADMIN_SESSION_TIMEOUT=60  # minutes
ADMIN_REFRESH_INTERVAL=30  # seconds

# Admin Security Features
ADMIN_2FA_REQUIRED=false  # Set to true to require 2FA for admin access
ADMIN_AUDIT_LOGGING=true  # Log all admin actions for security

# Admin Dashboard Settings
ADMIN_LOG_RETENTION_DAYS=30  # How long to keep admin logs

# Production Security Notes:
# 1. Change ADMIN_SECRET_KEY to a strong, random value
# 2. Set ADMIN_IP_WHITELIST to your office/home IP addresses
# 3. Enable ADMIN_2FA_REQUIRED in production
# 4. Monitor ADMIN_AUDIT_LOGGING for security events
# 5. Regularly rotate ADMIN_SECRET_KEY
